DATABASE_URL="postgresql://user:password@localhost:5432/humanity_one"
JWT_SECRET="your-super-secret-key-change-me"

# Primary AI provider (Gemini, OpenAI-compatible providers, etc.)
AI_API_KEY="your-primary-provider-key"
AI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
AI_MODEL="gemini-3.5-flash-lite"

# Optional explicit failover provider. Leave all three blank to avoid fallback usage/costs.
AI_FALLBACK_API_KEY=""
AI_FALLBACK_BASE_URL=""
AI_FALLBACK_MODEL=""

# Backward compatibility for existing OpenAI-only deployments.
OPENAI_API_KEY=""

FOUNDER_SETUP_SECRET="generate-a-long-random-one-time-secret"
