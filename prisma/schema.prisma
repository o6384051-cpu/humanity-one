generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  passwordHash String
  avatar       String?
  role         String    @default("USER")
  createdAt    DateTime  @default(now())
  projects     Project[]
  tasks        Task[]
  memories     Memory[]
  agents       Agent[]
  adminLogs    AdminAuditLog[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  progress    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime?
  priority  String    @default("medium")
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text
  category   String   @default("general")
  isExplicit Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   @default("assistant")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  source    String?
  category  String
  createdAt DateTime @default(now())
}

model JobListing {
  id                 String   @id @default(cuid())
  employerName       String
  businessType       String
  businessName       String
  city               String
  area               String?
  contactPhone       String
  contactEmail       String?
  employerAccessHash String?
  jobTitle           String
  description        String   @db.Text
  skills             String?
  experienceLevel    String   @default("لا يشترط خبرة")
  educationRequirement String @default("لا يشترط مؤهل")
  salaryMin          Int?
  salaryMax          Int?
  salaryPeriod       String   @default("شهري")
  employmentType     String   @default("دوام كامل")
  shift              String?
  openings           Int      @default(1)
  status             String   @default("PENDING")
  createdAt          DateTime @default(now())
  expiresAt          DateTime?
  applications       JobApplication[]
  @@index([status, createdAt])
  @@index([city, businessType])
}

model JobApplication {
  id          String     @id @default(cuid())
  jobId       String
  applicantName String
  phone       String
  experience  String?
  message     String?
  createdAt   DateTime   @default(now())
  job         JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([jobId, createdAt])
}

model BeneficiaryRequest {
  id             String   @id @default(cuid())
  requesterName  String
  phone          String
  city           String
  category       String
  details        String   @db.Text
  consent        Boolean  @default(false)
  status         String   @default("PENDING")
  adminNote      String?  @db.Text
  reviewedById   String?
  reviewedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([status, createdAt])
  @@index([phone, createdAt])
}

model AdminAuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  targetType  String
  targetId    String?
  metadata    Json?
  createdAt   DateTime @default(now())
  actor       User?    @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  @@index([createdAt])
  @@index([actorUserId, createdAt])
}

