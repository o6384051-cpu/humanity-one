generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  passwordResetTokenHash String?
  passwordResetExpiresAt DateTime?
  avatar              String?
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  projects            Project[]
  tasks               Task[]
  memories            Memory[]
  agents              Agent[]
  beneficiaryProfile  BeneficiaryProfile?
  assistanceRequests  AssistanceRequest[]
  beneficiaryFiles    BeneficiaryFile[]
  assistanceReviewEvents AssistanceReviewEvent[] @relation("AssistanceReviewActor")
  beneficiaryNotifications BeneficiaryNotification[]
  mailMessages          MailMessage[]
  verifiedRadarRecords HumanitarianRecord[] @relation("RadarRecordVerifier")
  radarAuditEvents RadarAuditEvent[] @relation("RadarAuditUser")
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  progress    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime?
  priority  String    @default("medium")
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text
  category   String   @default("general")
  isExplicit Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   @default("assistant")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  source    String?
  category  String
  createdAt DateTime @default(now())
}

model JobListing {
  id                   String   @id @default(cuid())
  employerName         String
  businessType         String
  businessName         String
  city                 String
  area                 String?
  contactPhone         String
  contactEmail         String?
  employerAccessHash   String?
  jobTitle             String
  description          String   @db.Text
  skills               String?
  experienceLevel      String   @default("لا يشترط خبرة")
  educationRequirement String   @default("لا يشترط مؤهل")
  salaryMin            Int?
  salaryMax            Int?
  salaryPeriod         String   @default("شهري")
  employmentType       String   @default("دوام كامل")
  shift                String?
  openings             Int      @default(1)
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  expiresAt            DateTime?
  applications         JobApplication[]

  @@index([status, createdAt])
  @@index([city, businessType])
}

model JobApplication {
  id            String     @id @default(cuid())
  jobId         String
  applicantName String
  phone         String
  experience    String?
  message       String?
  createdAt     DateTime   @default(now())
  job           JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model BeneficiaryProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  city             String?
  area             String?
  employmentStatus String?
  educationLevel   String?
  skills           String?  @db.Text
  householdSize    Int?
  monthlyIncome    Int?
  goals            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Restrict)
}

model AssistanceRequest {
  id          String   @id @default(cuid())
  userId      String
  category    String
  urgency     String   @default("NORMAL")
  description String   @db.Text
  city        String
  status      String   @default("PENDING")
  adminNote   String?  @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Restrict)
  files       BeneficiaryFile[]
  reviewEvents AssistanceReviewEvent[]
  notifications BeneficiaryNotification[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BeneficiaryFile {
  id           String           @id @default(cuid())
  userId       String
  requestId    String
  originalName String
  objectKey    String           @unique
  mimeType     String
  size         Int
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  request      AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)

  @@index([userId, requestId, createdAt])
}

model AssistanceReviewEvent {
  id           String           @id @default(cuid())
  requestId    String
  adminUserId  String?
  fromStatus   String?
  toStatus     String
  note         String?          @db.Text
  createdAt    DateTime         @default(now())
  request      AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Restrict)
  admin        User?            @relation("AssistanceReviewActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([adminUserId, createdAt])
}

model BeneficiaryNotification {
  id        String            @id @default(cuid())
  userId    String
  requestId String?
  type      String            @default("REQUEST_UPDATE")
  title     String
  message   String            @db.Text
  readAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Restrict)
  request   AssistanceRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId, readAt, createdAt])
  @@index([requestId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}


model MailMessage {
  id           String   @id @default(cuid())
  senderName   String
  senderEmail  String?
  department   String   @default("support")
  subject      String
  body         String   @db.Text
  status       String   @default("NEW")
  direction    String   @default("INBOUND")
  senderUserId String?
  parentId     String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  senderUser   User?    @relation(fields: [senderUserId], references: [id], onDelete: SetNull)
  parent       MailMessage? @relation("MailThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies      MailMessage[] @relation("MailThread")

  @@index([department, status, createdAt])
  @@index([parentId, createdAt])
  @@index([senderUserId, createdAt])
}


model OrganizationLead {
  id             String   @id @default(cuid())
  organizationName String
  country        String
  city           String?
  focusArea      String
  website        String?
  contactName    String?
  contactEmail   String?
  sourceUrl      String?
  status         String   @default("DISCOVERED")
  notes          String?  @db.Text
  lastContactAt  DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([status, country, createdAt])
  @@index([organizationName])
}

model Organization {
  id                   String   @id @default(cuid())
  applicationId        String   @unique
  name                 String
  email                String   @unique
  country              String   @default("غير محدد")
  city                 String?
  focusArea            String?
  website              String?
  status               String   @default("ACTIVE")
  passwordHash         String?
  activationTokenHash  String?  @unique
  activationExpiresAt  DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  conversationsAsA     OrganizationConversation[] @relation("ConversationOrganizationA")
  conversationsAsB     OrganizationConversation[] @relation("ConversationOrganizationB")
  sentMessages         OrganizationMessage[]
  ownedRadarRecords HumanitarianRecord[]
  radarShares RadarRecordShare[]
  radarAuditEvents RadarAuditEvent[]

  @@index([status, name])
}

model OrganizationConversation {
  id              String   @id @default(cuid())
  subject         String
  organizationAId String
  organizationBId String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  organizationA   Organization @relation("ConversationOrganizationA", fields: [organizationAId], references: [id], onDelete: Cascade)
  organizationB   Organization @relation("ConversationOrganizationB", fields: [organizationBId], references: [id], onDelete: Cascade)
  messages        OrganizationMessage[]

  @@index([organizationAId, updatedAt])
  @@index([organizationBId, updatedAt])
}

model OrganizationMessage {
  id             String   @id @default(cuid())
  conversationId String
  senderOrganizationId String
  body           String   @db.Text
  createdAt      DateTime @default(now())
  readAt         DateTime?
  conversation   OrganizationConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderOrganization Organization @relation(fields: [senderOrganizationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderOrganizationId, createdAt])
}


model HumanitarianRecord {
  id                    String   @id @default(cuid())
  organizationId        String
  type                  String
  title                 String
  description           String   @db.Text
  country               String
  city                  String?
  area                  String?
  latitude              Float?
  longitude             Float?
  locationPrecision     String   @default("APPROXIMATE")
  sourceName            String
  sourceUrl             String?
  sourceReference       String?
  observedAt            DateTime
  verificationStatus    String   @default("PENDING")
  verifiedAt            DateTime?
  verifiedByUserId      String?
  verificationNote      String?  @db.Text
  sharingMode           String   @default("PRIVATE")
  status                String   @default("ACTIVE")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  verifiedBy            User? @relation("RadarRecordVerifier", fields: [verifiedByUserId], references: [id], onDelete: SetNull)
  shares                RadarRecordShare[]
  auditEvents           RadarAuditEvent[]

  @@index([organizationId, createdAt])
  @@index([verificationStatus, observedAt])
  @@index([sharingMode, verificationStatus, country])
  @@index([type, status])
}

model RadarRecordShare {
  id                    String   @id @default(cuid())
  recordId              String
  organizationId        String
  permission            String   @default("VIEW")
  createdAt             DateTime @default(now())
  createdByOrganizationId String
  record                HumanitarianRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([recordId, organizationId])
  @@index([organizationId, createdAt])
}

model RadarAuditEvent {
  id                    String   @id @default(cuid())
  recordId              String
  action                String
  actorUserId           String?
  actorOrganizationId   String?
  details               Json?
  createdAt             DateTime @default(now())
  record                HumanitarianRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  actorUser             User? @relation("RadarAuditUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorOrganization     Organization? @relation(fields: [actorOrganizationId], references: [id], onDelete: SetNull)

  @@index([recordId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([actorOrganizationId, createdAt])
}
