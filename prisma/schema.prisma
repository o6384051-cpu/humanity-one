generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  name                String?
  passwordHash        String
  avatar              String?
  role                String               @default("USER")
  createdAt           DateTime             @default(now())
  projects            Project[]
  tasks               Task[]
  memories            Memory[]
  agents              Agent[]
  beneficiaryProfile  BeneficiaryProfile?
  assistanceRequests  AssistanceRequest[]
  beneficiaryFiles    BeneficiaryFile[]
  assistanceReviewEvents AssistanceReviewEvent[] @relation("AssistanceReviewActor")
  beneficiaryNotifications BeneficiaryNotification[]
}

model Project {
  id          String   @id @default(cuid())
  userId      String
  title       String
  description String?
  progress    Int      @default(0)
  status      String   @default("active")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Task {
  id        String    @id @default(cuid())
  userId    String
  title     String
  dueDate   DateTime?
  priority  String    @default("medium")
  completed Boolean   @default(false)
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Memory {
  id         String   @id @default(cuid())
  userId     String
  content    String   @db.Text
  category   String   @default("general")
  isExplicit Boolean  @default(false)
  createdAt  DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Agent {
  id          String   @id @default(cuid())
  userId      String
  name        String
  description String?
  type        String   @default("assistant")
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model KnowledgeDocument {
  id        String   @id @default(cuid())
  title     String
  content   String   @db.Text
  source    String?
  category  String
  createdAt DateTime @default(now())
}

model JobListing {
  id                   String   @id @default(cuid())
  employerName         String
  businessType         String
  businessName         String
  city                 String
  area                 String?
  contactPhone         String
  contactEmail         String?
  employerAccessHash   String?
  jobTitle             String
  description          String   @db.Text
  skills               String?
  experienceLevel      String   @default("لا يشترط خبرة")
  educationRequirement String   @default("لا يشترط مؤهل")
  salaryMin            Int?
  salaryMax            Int?
  salaryPeriod         String   @default("شهري")
  employmentType       String   @default("دوام كامل")
  shift                String?
  openings             Int      @default(1)
  status               String   @default("PENDING")
  createdAt            DateTime @default(now())
  expiresAt            DateTime?
  applications         JobApplication[]

  @@index([status, createdAt])
  @@index([city, businessType])
}

model JobApplication {
  id            String     @id @default(cuid())
  jobId         String
  applicantName String
  phone         String
  experience    String?
  message       String?
  createdAt     DateTime   @default(now())
  job           JobListing @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId, createdAt])
}

model BeneficiaryProfile {
  id               String   @id @default(cuid())
  userId           String   @unique
  phone            String?
  city             String?
  area             String?
  employmentStatus String?
  educationLevel   String?
  skills           String?  @db.Text
  householdSize    Int?
  monthlyIncome    Int?
  goals            String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AssistanceRequest {
  id          String   @id @default(cuid())
  userId      String
  category    String
  urgency     String   @default("NORMAL")
  description String   @db.Text
  city        String
  status      String   @default("PENDING")
  adminNote   String?  @db.Text
  reviewedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       BeneficiaryFile[]
  reviewEvents AssistanceReviewEvent[]
  notifications BeneficiaryNotification[]

  @@index([userId, createdAt])
  @@index([status, createdAt])
}

model BeneficiaryFile {
  id           String           @id @default(cuid())
  userId       String
  requestId    String
  originalName String
  objectKey    String           @unique
  mimeType     String
  size         Int
  createdAt    DateTime         @default(now())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  request      AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, requestId, createdAt])
}

model AssistanceReviewEvent {
  id           String           @id @default(cuid())
  requestId    String
  adminUserId  String?
  fromStatus   String?
  toStatus     String
  note         String?          @db.Text
  createdAt    DateTime         @default(now())
  request      AssistanceRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  admin        User?            @relation("AssistanceReviewActor", fields: [adminUserId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
  @@index([adminUserId, createdAt])
}

model BeneficiaryNotification {
  id        String            @id @default(cuid())
  userId    String
  requestId String?
  type      String            @default("REQUEST_UPDATE")
  title     String
  message   String            @db.Text
  readAt    DateTime?
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  request   AssistanceRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([requestId, createdAt])
}

model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}
